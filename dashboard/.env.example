# Copy this to .env.local and fill in your values

# Gemini API key — get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase connection string (recommended)
# Supabase dashboard → Settings → Database → Connection string → URI tab
# Disable connection pooling for direct Prisma connections
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# OR local postgres via docker-compose (fallback)
# DATABASE_URL=postgresql://canvas:canvas@localhost:5432/drug_canvas
